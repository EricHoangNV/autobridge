{
  "$defs": {
    "AuthSpec": {
      "additionalProperties": false,
      "description": "Credentials by reference only — never inline values (DIRECTIVES §6).\n\n``body_fields`` (spec v2): ``{body field path: credential_ref}``. Each\nvalue is an env key name holding the secret; at runtime the secret is\nread from the environment and placed into the named JSON body field.\n\n``edge_relay`` (spec v3): the connector is served by the on-premise\nedge relay queue instead of a vendor API. ``credential_ref`` names the\nenv key holding the relay operator token (read at runtime, never\nstored); no vendor credential exists on this transport.",
      "properties": {
        "type": {
          "enum": [
            "bearer",
            "api_key_header",
            "basic",
            "oauth2_client_credentials",
            "body_fields",
            "edge_relay"
          ],
          "title": "Type",
          "type": "string"
        },
        "credential_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Env key name holding the secret, never the value",
          "title": "Credential Ref"
        },
        "header_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Name"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        },
        "token_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Url"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "body_fields": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Body field path -> credential_ref env key (body_fields auth only)",
          "title": "Body Fields"
        }
      },
      "required": [
        "type"
      ],
      "title": "AuthSpec",
      "type": "object"
    },
    "Canary": {
      "additionalProperties": false,
      "properties": {
        "every": {
          "title": "Every",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "max_pages": {
          "default": 1,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        }
      },
      "required": [
        "every",
        "operation"
      ],
      "title": "Canary",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "read": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Read",
          "type": "array"
        },
        "action": {
          "items": {
            "type": "string"
          },
          "title": "Action",
          "type": "array"
        }
      },
      "required": [
        "read"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "Checkpoint": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "JSONPath subset, no expressions",
          "title": "Field",
          "type": "string"
        },
        "mode": {
          "default": "max",
          "enum": [
            "max",
            "min"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "Checkpoint",
      "type": "object"
    },
    "CommandTemplate": {
      "additionalProperties": false,
      "description": "One host-originated record template (spec v3): declarative command data.\n\nMirrors the edge bundle's command shape so a spec can carry what the\nagent executes: ``record`` names the framed record type, ``fields``\nmaps wire field ids to ``{param}`` templates, ``defaults`` fill\nmissing params, ``now`` names params filled with the current\nproperty-local wire date (``date`` → ``YYMMDD``) or time (anything\nelse → ``HHMMSS``), and ``expect`` is the answer waited for (``ack``\nor a two-letter record). Placeholders substitute strictly — a missing\nparam rejects the command before anything reaches the link.",
      "properties": {
        "record": {
          "description": "Framed record type sent, e.g. WR",
          "title": "Record",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Wire field id -> {param} template",
          "minProperties": 1,
          "title": "Fields",
          "type": "object"
        },
        "defaults": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Defaults",
          "type": "object"
        },
        "now": {
          "items": {
            "type": "string"
          },
          "title": "Now",
          "type": "array"
        },
        "expect": {
          "default": "ack",
          "description": "ack or the two-letter answer record",
          "title": "Expect",
          "type": "string"
        }
      },
      "required": [
        "record",
        "fields"
      ],
      "title": "CommandTemplate",
      "type": "object"
    },
    "ConnectorMeta": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "vendor": {
          "minLength": 1,
          "title": "Vendor",
          "type": "string"
        },
        "runtime_target": {
          "default": "cloud",
          "enum": [
            "cloud",
            "local",
            "sandbox",
            "edge"
          ],
          "title": "Runtime Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "vendor"
      ],
      "title": "ConnectorMeta",
      "type": "object"
    },
    "EntityCheck": {
      "additionalProperties": false,
      "description": "One invariant check on an entity's emitted records.\n\nSemantic invariants (P1.W6.1):\n- money_invariant: money field must be present, positive Decimal (detects gross->net drift via business rule)\n- business_date_invariant: business_date must correctly derive from posted_at via cutoff\n- count_invariant: alias for no_loss with stricter counting (kept for semantic drift naming)",
      "properties": {
        "kind": {
          "enum": [
            "unique_key",
            "no_loss",
            "date_order",
            "money_invariant",
            "business_date_invariant",
            "count_invariant"
          ],
          "title": "Kind",
          "type": "string"
        },
        "compare_to": {
          "anyOf": [
            {
              "description": "JSONPath subset, no expressions",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compare To"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "reference_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Field"
        },
        "cutoff": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cutoff"
        },
        "expected_sum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sum"
        },
        "tolerance_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance Pct"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EntityCheck",
      "type": "object"
    },
    "EntitySpec": {
      "additionalProperties": false,
      "description": "Mapping from one source operation to one canonical entity.",
      "properties": {
        "from": {
          "description": "Source operation name",
          "title": "From",
          "type": "string"
        },
        "key": {
          "description": "JSONPath subset, no expressions",
          "title": "Key",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldMapping"
          },
          "minProperties": 1,
          "title": "Fields",
          "type": "object"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/EntityCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "joins": {
          "items": {
            "$ref": "#/$defs/JoinSpec"
          },
          "title": "Joins",
          "type": "array"
        },
        "observed_wire_keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wire keys observed at build probe (names only)",
          "title": "Observed Wire Keys"
        }
      },
      "required": [
        "from",
        "key",
        "fields"
      ],
      "title": "EntitySpec",
      "type": "object"
    },
    "FeedSpec": {
      "additionalProperties": false,
      "description": "An event-driven source (spec v3): records pushed to the agent.\n\n``record`` names the framed record type consumed (e.g. ``PS``);\n``via`` names the queue the control plane drains (the edge relay);\n``dedupe_keys`` are wire field ids identifying one posting instance,\nso a resent record (same keys) is folded instead of doubled.",
      "properties": {
        "record": {
          "description": "Framed record type consumed, e.g. PS",
          "title": "Record",
          "type": "string"
        },
        "via": {
          "const": "edge_relay",
          "default": "edge_relay",
          "description": "Queue the control plane drains for this feed",
          "title": "Via",
          "type": "string"
        },
        "dedupe_keys": {
          "description": "Wire field ids forming the idempotency key",
          "items": {
            "type": "string"
          },
          "title": "Dedupe Keys",
          "type": "array"
        }
      },
      "required": [
        "record"
      ],
      "title": "FeedSpec",
      "type": "object"
    },
    "FieldMapping": {
      "additionalProperties": false,
      "description": "One canonical field: JSONPath subset plus transform pipeline.\n\nExactly one of ``path``/``paths`` — unless the pipeline starts with\n``const``, which needs no input (site facts like the property code or\ncurrency the docs state outright). ``paths`` (spec v3) extracts one\nvalue per listed path and feeds the list into the pipeline — e.g.\n``paths: [$.DA, $.TI]`` plus ``concat`` with a space separator turns a\nwire date and time into one datetime string for the date transforms.",
      "properties": {
        "path": {
          "anyOf": [
            {
              "description": "JSONPath subset, no expressions",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "paths": {
          "anyOf": [
            {
              "items": {
                "description": "JSONPath subset, no expressions",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paths"
        },
        "transform": {
          "items": {
            "$ref": "#/$defs/TransformStep"
          },
          "title": "Transform",
          "type": "array"
        }
      },
      "title": "FieldMapping",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "default": true,
          "title": "Keys",
          "type": "boolean"
        },
        "types": {
          "default": true,
          "title": "Types",
          "type": "boolean"
        },
        "pagination_shape": {
          "default": true,
          "title": "Pagination Shape",
          "type": "boolean"
        }
      },
      "title": "Fingerprint",
      "type": "object"
    },
    "HealthSpec": {
      "additionalProperties": false,
      "properties": {
        "canary": {
          "$ref": "#/$defs/Canary"
        },
        "fingerprint": {
          "$ref": "#/$defs/Fingerprint"
        }
      },
      "required": [
        "canary"
      ],
      "title": "HealthSpec",
      "type": "object"
    },
    "JoinField": {
      "additionalProperties": false,
      "description": "One computed value from the matched joined record(s) (spec v2).\n\n``one`` cardinality: exactly one of ``path``/``paths``; ``paths``\nextracts several values from the single matched record and feeds them\nas a list into the transform pipeline (e.g. ``concat`` over\n``[FirstName, LastName]``). ``many`` cardinality: ``path`` is read\nfrom every matched record and reduced by ``aggregate`` (required),\ne.g. ``sum`` over line-item gross amounts. ``transform`` reuses the\nclosed transform set (``money``, ``concat``, ...), never code.",
      "properties": {
        "path": {
          "anyOf": [
            {
              "description": "JSONPath subset, no expressions",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "paths": {
          "anyOf": [
            {
              "items": {
                "description": "JSONPath subset, no expressions",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paths"
        },
        "aggregate": {
          "anyOf": [
            {
              "enum": [
                "first",
                "sum",
                "count",
                "min",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregate"
        },
        "transform": {
          "items": {
            "$ref": "#/$defs/TransformStep"
          },
          "title": "Transform",
          "type": "array"
        }
      },
      "title": "JoinField",
      "type": "object"
    },
    "JoinSpec": {
      "additionalProperties": false,
      "description": "Declarative enrichment of one entity from another operation (spec v2).\n\nRecords from ``from_operation`` are indexed by ``foreign_key``; each\nbase record looks up ``local_key``. ``one`` attaches computed scalars\nfrom the first match under ``_joined.<as>``; ``many`` aggregates over\nall matches. The attached namespace is reserved: vendor records never\ncarry ``_joined``, so enrichment cannot collide with wire data.",
      "properties": {
        "from_operation": {
          "title": "From Operation",
          "type": "string"
        },
        "local_key": {
          "description": "JSONPath subset, no expressions",
          "title": "Local Key",
          "type": "string"
        },
        "foreign_key": {
          "description": "JSONPath subset, no expressions",
          "title": "Foreign Key",
          "type": "string"
        },
        "cardinality": {
          "default": "one",
          "enum": [
            "one",
            "many"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "as": {
          "description": "Namespace attached under _joined",
          "title": "As",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/JoinField"
          },
          "minProperties": 1,
          "title": "Fields",
          "type": "object"
        }
      },
      "required": [
        "from_operation",
        "local_key",
        "foreign_key",
        "as",
        "fields"
      ],
      "title": "JoinSpec",
      "type": "object"
    },
    "LinkSpec": {
      "additionalProperties": false,
      "description": "Framed-transport settings as data (spec v3, ``fias_tcp`` only).\n\n``announced_records`` are the two-letter record codes the host tells\nthe peer it wants to exchange (the ``LR`` announcement); the peer only\nsends those types, in the announced field order. ``ack_mode`` and\n``max_frame_bytes`` are the installation's framing contract.",
      "properties": {
        "ack_mode": {
          "default": true,
          "title": "Ack Mode",
          "type": "boolean"
        },
        "max_frame_bytes": {
          "default": 65536,
          "minimum": 1,
          "title": "Max Frame Bytes",
          "type": "integer"
        },
        "announced_records": {
          "description": "Record codes the host announces interest in",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Announced Records",
          "type": "array"
        }
      },
      "required": [
        "announced_records"
      ],
      "title": "LinkSpec",
      "type": "object"
    },
    "OperationSpec": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "POST",
            "EVENT"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "default": "",
          "title": "Path",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Params",
          "type": "object"
        },
        "body": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pagination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Checkpoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feed": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeedSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Event-driven source (spec v3, EVENT method only)"
        }
      },
      "title": "OperationSpec",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "offset",
            "cursor",
            "page",
            "body_cursor"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "cursor_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor Param"
        },
        "offset_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Param"
        },
        "page_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Param"
        },
        "limit_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Param"
        },
        "next_path": {
          "anyOf": [
            {
              "description": "JSONPath subset, no expressions",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Path"
        },
        "items_path": {
          "description": "JSONPath subset, no expressions",
          "title": "Items Path",
          "type": "string"
        },
        "total_path": {
          "anyOf": [
            {
              "description": "JSONPath subset, no expressions",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Path"
        },
        "stop_when": {
          "items": {
            "enum": [
              "null_cursor",
              "repeated_cursor",
              "empty_page",
              "page_limit",
              "no_next"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Stop When",
          "type": "array"
        },
        "cursor_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dotted body path holding the request cursor (body_cursor only)",
          "title": "Cursor Path"
        },
        "count_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dotted body path holding the page size (body_cursor only)",
          "title": "Count Path"
        },
        "count_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page size sent at count_path (body_cursor only)",
          "title": "Count Value"
        }
      },
      "required": [
        "strategy",
        "items_path",
        "stop_when"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "RateLimit": {
      "additionalProperties": false,
      "properties": {
        "max_rps": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "title": "Max Rps",
          "type": "number"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        }
      },
      "title": "RateLimit",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "statuses": {
          "items": {
            "type": "integer"
          },
          "title": "Statuses",
          "type": "array"
        },
        "backoff": {
          "default": "exponential",
          "enum": [
            "exponential",
            "linear",
            "constant"
          ],
          "title": "Backoff",
          "type": "string"
        },
        "max_attempts": {
          "default": 5,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "SourceSpec": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "protocol": {
          "default": "http",
          "description": "Transport: http (polled vendor API) or fias_tcp (event-driven framed protocol, spec v3)",
          "enum": [
            "http",
            "fias_tcp"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "auth": {
          "$ref": "#/$defs/AuthSpec"
        },
        "rate_limit": {
          "$ref": "#/$defs/RateLimit"
        },
        "timezone_source": {
          "$ref": "#/$defs/TimezoneSource"
        },
        "link": {
          "anyOf": [
