# Engine-zone image: control, worker, runtime-sandbox, bench (plan §2.1).
# Build context is the repo root; serves any engine app via $APP_MODULE.
#
# AR-2-5 reproducible builds: the base image is digest-pinned, and Python
# dependencies come from requirements.engine.lock (regenerate with
# `make lockfiles` after changing pyproject.toml/uv.lock) installed with
# --require-hashes. The project itself installs --no-deps from the
# version-controlled source — local code is deterministic by definition, so
# no PyPI lookup can float the engine.
FROM python:3.12-slim@sha256:6b25cbe6577518889d553cdd5a5da97d259348d8f6e45b527dd731caaba27a07

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/srv/src:/srv

WORKDIR /srv

# Install the engine's locked runtime dependencies (P1.W9.1: the image
# previously installed only fastapi/uvicorn, so control/worker crashed on
# `import sqlalchemy`). The lockfile keeps the image in sync with uv.lock
# instead of duplicating the pin list here.
COPY requirements.engine.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.engine.lock

COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --no-deps .

COPY src/ ./src/

# REQ-024 owner check (bench out of the engine package): the harness lives
# in top-level bench/ and is served as APP_MODULE=bench.app:app by the
# bench service. It imports the engine (like the tests do), never the
# reverse — engine code must not import bench (trust-boundary test).
COPY bench/ ./bench/

# REQ-021 owner check: the control plane migrates on startup, so the image
# must ship the Alembic scripts next to src/ (mirrors the repo layout).
COPY alembic/ ./alembic/

# REQ-022 owner check 2026-10-29: the demo target registry lives in
# config/demo_targets.yaml (out of engine source); the control plane loads
# it at startup, so the image must ship it next to src/ (mirrors the repo
# layout: default_targets_path() resolves parents[3]/config).
COPY config/ ./config/

# P2.S4.1: the MCP Guardian mock lives in mcp_stretch/ (engine trust zone)
# and is served as APP_MODULE=mcp_stretch.app:app by the mcp-hotel service.
COPY mcp_stretch/ ./mcp_stretch/

EXPOSE 8000

# APP_MODULE is set per service in compose.yaml, e.g. autobridge.control.app:app
CMD ["sh", "-c", "uvicorn \"$APP_MODULE\" --host 0.0.0.0 --port 8000"]
