# Copy to .env (git-ignored). ralph-afk.sh sources this file.
# Secrets stay here as values; specs, releases, evidence and API responses
# carry only the key names (credential_ref), never the values.

# Slack incoming webhook for loop notifications (optional)
SLACK_WEBHOOK=

# ---- ralph-afk.sh: agent runtime and provider (one per run, no fallback) ----
# Default agent and OpenCode provider when no --agent/--provider is given: claude | opencode; baseten | modal | meta
RALPH_AGENT=opencode
RALPH_PROVIDER=meta
# OpenCode provider keys (env names are the ones OpenCode's catalog expects per provider).
# ralph passes the chosen provider's key into the OpenCode sandbox as a bare -e NAME.
BASETEN_API_KEY=
MODAL_PROXY_TOKEN=
# Your shared endpoint (modal endpoint create --shared --model <id>), ending in /v1. Proxy token above is wk-<id>.ws-<secret>.
MODAL_BASE_URL=
META_MODEL_API_KEY=
# Model id per provider.
# Baseten's Spark Open id is declared in opencode.json; change it there and here if Baseten names it differently.
BASETEN_MODEL=meta-models/muse-spark-open-1026
MODAL_MODEL=meta-models/Muse-Spark-Open-816B-A42B
META_MODEL=muse-spark-1.3          # or muse-spark-1.3-contributor (cheaper; inputs used for Meta training), muse-wonder-1.0
# The Claude Code tier has no model setting here: pick it with /model inside the Claude sandbox
# (sbx run --name claude-autobridge); the loop reads the saved choice for the commit trailer.

# ---- AutoBridge itself (plan §2.9). Model ids live in config, never in code. ----
ANTHROPIC_API_KEY=
ANTHROPIC_FRONTIER_MODEL=
ANTHROPIC_SMALL_MODEL=
OPENAI_API_KEY=
OPENAI_FRONTIER_MODEL=
OPENAI_SMALL_MODEL=
# Meta Muse frontier tier via its OpenAI-compatible chat completions API
# (REQ-021 item 5; the frontier tier behind LLMProvider + Budget + ModelCall).
# The owner generates a dedicated Muse key; it is read only from env, never
# logged or stored. Empty key = no live frontier calls (replay mode covers
# the demo). Anthropic stays available as an alternative provider.
FRONTIER_API_KEY=
# Defaults: https://api.meta.ai/v1 and muse-spark-1.3 when left empty.
FRONTIER_BASE_URL=
FRONTIER_MODEL=
# Small tier (L2): same provider and key; defaults to FRONTIER_MODEL.
SMALL_MODEL=

# Control-plane database: SQLite file by default, Postgres URL in prod
# (read as DATABASE_URL by src/autobridge/control/models.py and alembic/env.py)
DATABASE_URL=

# Runtime mode (REQ-017): local | docker | empty (auto). `make local-up`
# forces local; otherwise local when no Docker daemon answers, docker when
# one does. Local mode uses LocalProcessTarget (no network isolation) and
# says so on every /readyz and in the UI header.
AUTOBRIDGE_RUNTIME=

# Operator name shown on approvals and recorded on Approval.actor (default: operator)
AUTOBRIDGE_OPERATOR=

# Optional bearer token guarding the control API's state-changing routes
# (POST/PUT/PATCH/DELETE answer 401 without it when set). Leave empty for
# local runs; set it before exposing the stack beyond localhost.
AUTOBRIDGE_CONTROL_TOKEN=

# Shared secret authorizing simulator admin writes (AR-1-1). The header
# X-Admin-Network is only a routing hint; without this token any vendor-net
# peer can inject faults. Leave empty for header-only local dev; set a random
# value (e.g. openssl rand -hex 32) before exposing the stack beyond localhost.
# Control and the simulators read the same value; never commit a real one.
SIM_ADMIN_TOKEN=

# HMAC key for edge release signatures (AR-2-4). Control/worker sign releases
# with it and the edge worker verifies with it; without it signatures are
# unkeyed integrity checksums anyone can recompute (local dev only). Set a
# random value (e.g. openssl rand -hex 32) before exposing the stack beyond
# localhost; never commit a real one.
EDGE_RELEASE_SECRET=

# Service URLs (defaults match compose host ports; set only to override)
VERIFIER_URL=
SIMULATOR_ADMIN_URL=
# Host IP that compose publishes stack ports on (default 127.0.0.1 = localhost only).
# WARNING: setting 0.0.0.0 exposes the unauthenticated control API, UI and simulators
# to the whole local network — only do so on a trusted network.
# (AR-1-4: the verifier :8104 and simulator admin ports :8109/:8110/:8112 ignore
# this setting and stay loopback-only regardless.)
AUTOBRIDGE_BIND_HOST=
# Set inside Compose containers so the demo fault bridge uses service DNS
# (host mode falls back to localhost:8109/8110)
ADMIN_NET_HOST=

# Simulator credentials are env refs named in each ConnectorSpec (credential_ref), never literal values in specs
ATLAS_BASE_URL=http://sim-atlas:8000
ATLAS_API_KEY=
HARBOR_BASE_URL=http://sim-harbor:8000
HARBOR_API_KEY=

# ---- Benchmark (make bench; see docs/benchmark.md) ----
# BASELINE_DRIVER: claude | codex | llm | one_shot (default: claude when the binary exists, else llm fallback)
BASELINE_DRIVER=
BENCH_SCENARIOS=
BENCH_SEED=
BENCH_TRIALS=
BENCH_VISIBILITY=
BENCH_NO_SCORE=
# Headless baseline CLI paths (defaults: claude / codex on PATH)
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=

# ---- E2E harness (make e2e; see tests/e2e/conftest.py) ----
# E2E_SKIP_STACK=1 reuse the `make up` stack · E2E_KEEP_STACK=1 no teardown · E2E_TIMEOUT readyz wait seconds
E2E_SKIP_STACK=
E2E_KEEP_STACK=
E2E_TIMEOUT=
