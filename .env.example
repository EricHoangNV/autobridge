# Copy to .env (git-ignored). ralph-afk.sh sources this file.
# Secrets stay here as values; specs, releases, evidence and API responses
# carry only the key names (credential_ref), never the values.

# Slack incoming webhook for loop notifications (optional)
SLACK_WEBHOOK=

# ---- ralph-afk.sh: agent runtime and provider (one per run, no fallback) ----
# Default agent and OpenCode provider when no --agent/--provider is given: claude | opencode; baseten | modal | meta
RALPH_AGENT=opencode
RALPH_PROVIDER=meta
# OpenCode provider keys (env names are the ones OpenCode's catalog expects per provider).
# ralph passes the chosen provider's key into the OpenCode sandbox as a bare -e NAME.
BASETEN_API_KEY=
MODAL_PROXY_TOKEN=
# Your shared endpoint (modal endpoint create --shared --model <id>), ending in /v1. Proxy token above is wk-<id>.ws-<secret>.
MODAL_BASE_URL=
META_MODEL_API_KEY=
# Model id per provider.
# Baseten's Spark Open id is declared in opencode.json; change it there and here if Baseten names it differently.
BASETEN_MODEL=meta-models/muse-spark-open-1026
MODAL_MODEL=meta-models/Muse-Spark-Open-816B-A42B
META_MODEL=muse-spark-1.3          # or muse-spark-1.3-contributor (cheaper; inputs used for Meta training), muse-wonder-1.0
# The Claude Code tier has no model setting here: pick it with /model inside the Claude sandbox
# (sbx run --name claude-autobridge); the loop reads the saved choice for the commit trailer.

# ---- AutoBridge itself (plan §2.9). Model ids live in config, never in code. ----
ANTHROPIC_API_KEY=
ANTHROPIC_FRONTIER_MODEL=
ANTHROPIC_SMALL_MODEL=
OPENAI_API_KEY=
OPENAI_FRONTIER_MODEL=
OPENAI_SMALL_MODEL=

# Control-plane database: SQLite file by default, Postgres URL in prod
# (read as DATABASE_URL by src/autobridge/control/models.py and alembic/env.py)
DATABASE_URL=

# Operator name shown on approvals and recorded on Approval.actor (default: operator)
AUTOBRIDGE_OPERATOR=

# Service URLs (defaults match compose host ports; set only to override)
VERIFIER_URL=
SIMULATOR_ADMIN_URL=
# Host IP that compose publishes stack ports on (default 127.0.0.1 = localhost only).
# WARNING: setting 0.0.0.0 exposes the unauthenticated control API, UI, simulators
# and verifier to the whole local network — only do so on a trusted network.
AUTOBRIDGE_BIND_HOST=
# Set inside Compose containers so the demo fault bridge uses service DNS
# (host mode falls back to localhost:8109/8110)
ADMIN_NET_HOST=

# Simulator credentials are env refs named in each ConnectorSpec (credential_ref), never literal values in specs
ATLAS_BASE_URL=http://sim-atlas:8000
ATLAS_API_KEY=
HARBOR_BASE_URL=http://sim-harbor:8000
HARBOR_API_KEY=

# ---- Benchmark (make bench; see docs/benchmark.md) ----
# BASELINE_DRIVER: claude | codex | llm | one_shot (default: claude when the binary exists, else llm fallback)
BASELINE_DRIVER=
BENCH_SCENARIOS=
BENCH_SEED=
BENCH_TRIALS=
BENCH_VISIBILITY=
BENCH_NO_SCORE=
# Headless baseline CLI paths (defaults: claude / codex on PATH)
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=

# ---- E2E harness (make e2e; see tests/e2e/conftest.py) ----
# E2E_SKIP_STACK=1 reuse the `make up` stack · E2E_KEEP_STACK=1 no teardown · E2E_TIMEOUT readyz wait seconds
E2E_SKIP_STACK=
E2E_KEEP_STACK=
E2E_TIMEOUT=
