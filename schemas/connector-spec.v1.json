{
  "$defs": {
    "AuthSpec": {
      "additionalProperties": false,
      "description": "Credentials by reference only \u2014 never inline values (DIRECTIVES \u00a76).",
      "properties": {
        "type": {
          "enum": [
            "bearer",
            "api_key_header",
            "basic",
            "oauth2_client_credentials"
          ],
          "title": "Type",
          "type": "string"
        },
        "credential_ref": {
          "description": "Env key name holding the secret, never the value",
          "title": "Credential Ref",
          "type": "string"
        },
        "header_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Name"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        },
        "token_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Url"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "type",
        "credential_ref"
      ],
      "title": "AuthSpec",
      "type": "object"
    },
    "Canary": {
      "additionalProperties": false,
      "properties": {
        "every": {
          "title": "Every",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "max_pages": {
          "default": 1,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        }
      },
      "required": [
        "every",
        "operation"
      ],
      "title": "Canary",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "read": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Read",
          "type": "array"
        },
        "action": {
          "items": {
            "type": "string"
          },
          "title": "Action",
          "type": "array"
        }
      },
      "required": [
        "read"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "Checkpoint": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "JSONPath subset, no expressions",
          "title": "Field",
          "type": "string"
        },
        "mode": {
          "default": "max",
          "enum": [
            "max",
            "min"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "Checkpoint",
      "type": "object"
    },
    "ConnectorMeta": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "vendor": {
          "minLength": 1,
          "title": "Vendor",
          "type": "string"
        },
        "runtime_target": {
          "default": "cloud",
          "enum": [
            "cloud",
            "local",
            "sandbox",
            "edge"
          ],
          "title": "Runtime Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "vendor"
      ],
      "title": "ConnectorMeta",
      "type": "object"
    },
    "EntityCheck": {
      "additionalProperties": false,
      "description": "One invariant check on an entity's emitted records.\n\nSemantic invariants (P1.W6.1):\n- money_invariant: money field must be present, positive Decimal (detects gross->net drift via business rule)\n- business_date_invariant: business_date must correctly derive from posted_at via cutoff\n- count_invariant: alias for no_loss with stricter counting (kept for semantic drift naming)",
      "properties": {
        "kind": {
          "enum": [
            "unique_key",
            "no_loss",
            "date_order",
            "money_invariant",
            "business_date_invariant",
            "count_invariant"
          ],
          "title": "Kind",
          "type": "string"
        },
        "compare_to": {
          "anyOf": [
            {
              "description": "JSONPath subset, no expressions",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compare To"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "reference_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Field"
        },
        "cutoff": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cutoff"
        },
        "expected_sum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sum"
        },
        "tolerance_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance Pct"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EntityCheck",
      "type": "object"
    },
    "EntitySpec": {
      "additionalProperties": false,
      "description": "Mapping from one source operation to one canonical entity.",
      "properties": {
        "from": {
          "description": "Source operation name",
          "title": "From",
          "type": "string"
        },
        "key": {
          "description": "JSONPath subset, no expressions",
          "title": "Key",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldMapping"
          },
          "minProperties": 1,
          "title": "Fields",
          "type": "object"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/EntityCheck"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "from",
        "key",
        "fields"
      ],
      "title": "EntitySpec",
      "type": "object"
    },
    "FieldMapping": {
      "additionalProperties": false,
      "description": "One canonical field: source JSONPath plus transform pipeline.",
      "properties": {
        "path": {
          "description": "JSONPath subset, no expressions",
          "title": "Path",
          "type": "string"
        },
        "transform": {
          "items": {
            "$ref": "#/$defs/TransformStep"
          },
          "title": "Transform",
          "type": "array"
        }
      },
      "required": [
        "path"
      ],
      "title": "FieldMapping",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "default": true,
          "title": "Keys",
          "type": "boolean"
        },
        "types": {
          "default": true,
          "title": "Types",
          "type": "boolean"
        },
        "pagination_shape": {
          "default": true,
          "title": "Pagination Shape",
          "type": "boolean"
        }
      },
      "title": "Fingerprint",
      "type": "object"
    },
    "HealthSpec": {
      "additionalProperties": false,
      "properties": {
        "canary": {
          "$ref": "#/$defs/Canary"
        },
        "fingerprint": {
          "$ref": "#/$defs/Fingerprint"
        }
      },
      "required": [
        "canary"
      ],
      "title": "HealthSpec",
      "type": "object"
    },
    "OperationSpec": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "GET",
          "default": "GET",
          "title": "Method",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Params",
          "type": "object"
        },
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pagination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Checkpoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "path"
      ],
      "title": "OperationSpec",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "offset",
            "cursor",
            "page"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "cursor_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor Param"
        },
        "offset_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Param"
        },
        "page_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Param"
        },
        "limit_param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Param"
        },
        "next_path": {
          "anyOf": [
            {
              "description": "JSONPath subset, no expressions",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Path"
        },
        "items_path": {
          "description": "JSONPath subset, no expressions",
          "title": "Items Path",
          "type": "string"
        },
        "stop_when": {
          "items": {
            "enum": [
              "null_cursor",
              "repeated_cursor",
              "empty_page",
              "page_limit",
              "no_next"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Stop When",
          "type": "array"
        }
      },
      "required": [
        "strategy",
        "items_path",
        "stop_when"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "RateLimit": {
      "additionalProperties": false,
      "properties": {
        "max_rps": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "title": "Max Rps",
          "type": "number"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        }
      },
      "title": "RateLimit",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "statuses": {
          "items": {
            "type": "integer"
          },
          "title": "Statuses",
          "type": "array"
        },
        "backoff": {
          "default": "exponential",
          "enum": [
            "exponential",
            "linear",
            "constant"
          ],
          "title": "Backoff",
          "type": "string"
        },
        "max_attempts": {
          "default": 5,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "SourceSpec": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "auth": {
          "$ref": "#/$defs/AuthSpec"
        },
        "rate_limit": {
          "$ref": "#/$defs/RateLimit"
        },
        "timezone_source": {
          "$ref": "#/$defs/TimezoneSource"
        }
      },
      "required": [
        "base_url",
        "auth",
        "timezone_source"
      ],
      "title": "SourceSpec",
      "type": "object"
    },
    "TimezoneSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "static",
            "field"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "path": {
          "anyOf": [
            {
              "description": "JSONPath subset, no expressions",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "kind"
      ],
      "title": "TimezoneSource",
      "type": "object"
    },
    "TransformStep": {
      "additionalProperties": false,
      "description": "One closed-set transform call with its arguments.",
      "properties": {
        "name": {
          "description": "Closed transform name (plan \u00a72.4)",
          "enum": [
            "date_local",
            "datetime_utc",
            "money",
            "enum_map",
            "flatten",
            "coalesce",
            "const",
            "concat",
            "business_date"
          ],
          "title": "Name",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "TransformStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The declarative connector document (spec_version 1).",
  "properties": {
    "spec_version": {
      "const": 1,
      "title": "Spec Version",
      "type": "integer"
    },
    "connector": {
      "$ref": "#/$defs/ConnectorMeta"
    },
    "source": {
      "$ref": "#/$defs/SourceSpec"
    },
    "operations": {
      "additionalProperties": {
        "$ref": "#/$defs/OperationSpec"
      },
      "minProperties": 1,
      "title": "Operations",
      "type": "object"
    },
    "entities": {
      "additionalProperties": {
        "$ref": "#/$defs/EntitySpec"
      },
      "minProperties": 1,
      "title": "Entities",
      "type": "object"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "health": {
      "$ref": "#/$defs/HealthSpec"
    }
  },
  "required": [
    "spec_version",
    "connector",
    "source",
    "operations",
    "entities",
    "capabilities",
    "health"
  ],
  "title": "ConnectorSpec",
  "type": "object"
}
